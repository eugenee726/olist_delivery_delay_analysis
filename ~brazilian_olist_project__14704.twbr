            </column>
            <column caption='mometary_segment' datatype='integer' name='[Calculation_2158920165842950]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [monetary] &lt;= 40 THEN 1&#13;&#10;ELSEIF [monetary] &lt;= 60 THEN 2&#13;&#10;ELSEIF [monetary] &lt;= 75 THEN 3&#13;&#10;ELSEIF [monetary] &lt;= 90 THEN 4&#13;&#10;ELSEIF [monetary] &lt;= 110 THEN 5&#13;&#10;ELSEIF [monetary] &lt;= 130 THEN 6&#13;&#10;ELSEIF [monetary] &lt;= 160 THEN 7&#13;&#10;ELSEIF [monetary] &lt;= 210 THEN 8&#13;&#10;ELSEIF [monetary] &lt;= 310 THEN 9&#13;&#10;ELSEIF [monetary] &gt; 310 THEN 10&#13;&#10;END' />
            </column>
            <column caption='rfm' datatype='integer' name='[Calculation_2494271309996032]' role='measure' type='quantitative'>
