            <column caption='AVG arrived day (delivery list.csv)' datatype='real' name='[AVG_arrived_day (delivery_list.csv)]' role='dimension' type='quantitative' />
            <column caption='AVG carreier time' datatype='real' name='[AVG_carreier_time]' role='measure' type='quantitative' />
            <column caption='AVG estimated time' datatype='real' name='[AVG_estimated_time]' role='measure' type='quantitative' />
            <column caption='AVG review score' datatype='integer' name='[AVG_review_score]' role='measure' type='quantitative' />
            <column caption='Frequency_Segment2' datatype='integer' name='[Calculation_0973647342428161]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [frequency] &lt;= 1 then 1&#13;&#10;ELSEIF [frequency] &lt;= 2 then 2&#13;&#10;ELSE 3&#13;&#10;END' />
            </column>
            <column caption='recency_segment' datatype='integer' name='[Calculation_2158920144101377]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [recency] &lt;= 40 then 10&#13;&#10;ELSEIF [recency] &lt;= 90 then 9&#13;&#10;ELSEIF [recency] &lt;= 130 then 8&#13;&#10;ELSEIF [recency] &lt;= 170 then 7&#13;&#10;ELSEIF [recency] &lt;= 210 then 6&#13;&#10;ELSEIF [recency] &lt;= 260 then 5&#13;&#10;ELSEIF [recency] &lt;= 310 then 4&#13;&#10;ELSEIF [recency] &lt;= 380 then 3&#13;&#10;ELSEIF [recency] &lt;= 460 then 2&#13;&#10;ELSEIF [recency] &gt; 460 then 1&#13;&#10;END' />
            </column>
            <column caption='*Customer_Unique_id' datatype='integer' name='[Calculation_2158920147525634]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD([customer_unique_id])' />
            </column>
            <column caption='Frequency_Segment' datatype='integer' name='[Calculation_2158920153477124]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [frequency] = 1 THEN 1&#13;&#10;ELSEIF [frequency] &gt;= 2 THEN 2&#13;&#10;END' />
            </column>
            <column caption='mometary_segment' datatype='integer' name='[Calculation_2158920165842950]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [monetary] &lt;= 40 THEN 1&#13;&#10;ELSEIF [monetary] &lt;= 60 THEN 2&#13;&#10;ELSEIF [monetary] &lt;= 75 THEN 3&#13;&#10;ELSEIF [monetary] &lt;= 90 THEN 4&#13;&#10;ELSEIF [monetary] &lt;= 110 THEN 5&#13;&#10;ELSEIF [monetary] &lt;= 130 THEN 6&#13;&#10;ELSEIF [monetary] &lt;= 160 THEN 7&#13;&#10;ELSEIF [monetary] &lt;= 210 THEN 8&#13;&#10;ELSEIF [monetary] &lt;= 310 THEN 9&#13;&#10;ELSEIF [monetary] &gt; 310 THEN 10&#13;&#10;END' />
            </column>
            <column caption='rfm' datatype='integer' name='[Calculation_2494271309996032]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_2158920153477124] + [Calculation_2158920165842950] + [Calculation_2158920144101377]' />
            </column>
            <column caption='*Avg Review Score' datatype='real' datatype-customized='true' name='[Calculation_2494271314067458]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG([AVG_review_score])' />
